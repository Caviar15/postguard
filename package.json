{
  "name": "postguard",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-flight QA for a Buffer queue. Flags posts that will break at publish time.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:signed-in": "bash e2e-local/run-signed-in.sh",
    "test:e2e:prod": "playwright test -c e2e-prod/playwright.prod.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ai": "^6.0.330",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
