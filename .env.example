# Register a confidential (private) app client at
# https://publish.buffer.com/settings/api
# Scopes to enable on the client: account:read, posts:read, offline_access.

BUFFER_CLIENT_ID=
# Required for a confidential client. Omit only if you registered a public client.
BUFFER_CLIENT_SECRET=

# Must match a redirect URI registered on the Buffer app, character for character.
# Local:  http://localhost:3000/api/auth/callback
# Vercel: https://YOUR_PROJECT.vercel.app/api/auth/callback
BUFFER_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 32+ random characters. Encrypts the refresh token cookie. Required for OAuth.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. How many days ahead a scan covers. The dashboard can override this.
POSTGUARD_WINDOW_DAYS=7

# Optional. Public origin, used only as a hint in the UI. Redirects use the request host.
APP_URL=http://localhost:3000

# Optional: daily alert email (see README, "Alerts").
# At least 16 characters. Vercel Cron sends it as "Authorization: Bearer ...". It is also the setup code at /alerts/setup.
# Unset: /api/cron/alerts answers 500 and nothing runs.
CRON_SECRET=
# Upstash Redis REST (Vercel Marketplace sets these). Holds the encrypted alert grant, the run lock and dedupe claims.
KV_REST_API_URL=
KV_REST_API_TOKEN=
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Default: PostGuard <onboarding@resend.dev>
ALERT_EMAIL_FROM=
# Default: Europe/Amsterdam
ALERT_TIME_ZONE=
